<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regression checks for the scan processing and PDF export against the reference scans
       in ..\TestData (not in Git, see TestData\README.md). Run: "dotnet run -c Release", optionally followed by
       a double dash and another test folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PdnScanCrop\ScanProcessor.cs" Link="Shared\ScanProcessor.cs" />
    <Compile Include="..\PdnScanCrop\ScanJpegWriter.cs" Link="Shared\ScanJpegWriter.cs" />
    <Compile Include="..\PdnScanCrop.Ocr\OcrScorer.cs" Link="Shared\OcrScorer.cs" />
    <Compile Include="..\MusicBookCreator\ImageIo.cs" Link="App\ImageIo.cs" />
    <Compile Include="..\MusicBookCreator\BatchProcessor.cs" Link="App\BatchProcessor.cs" />
    <Compile Include="..\MusicBookCreator\PdfBookWriter.cs" Link="App\PdfBookWriter.cs" />
  </ItemGroup>

</Project>
