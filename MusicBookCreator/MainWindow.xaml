<Window x:Class="MusicBookCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MusicBookCreator"
        Title="Music Book Creator" Width="1280" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Folders -->
        <Grid Grid.Row="0" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Quellordner:" Style="{StaticResource SettingLabel}" />
            <TextBox Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
            <Button Grid.Column="2" Content="…" Command="{Binding BrowseSourceCommand}" Margin="6,2,0,2" ToolTip="Ordner wählen" />
            <TextBlock Grid.Row="1" Text="Zielordner:" Style="{StaticResource SettingLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TargetFolder, UpdateSourceTrigger=LostFocus}" Margin="0,2" />
            <Button Grid.Row="1" Grid.Column="2" Content="…" Command="{Binding BrowseTargetCommand}" Margin="6,2,0,2" ToolTip="Ordner wählen" />
        </Grid>

        <!-- Settings -->
        <Border Grid.Row="1" Margin="0,10,0,10" Padding="12" BorderThickness="1" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                        <TextBlock Text="Drehen" Style="{StaticResource SettingLabel}" />
                        <ComboBox SelectedIndex="{Binding RotationIndex}" Width="130">
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="Nicht drehen" />
                            <ComboBoxItem Content="180° drehen" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Content="Graustufen" IsChecked="{Binding Grayscale}" VerticalAlignment="Center" Margin="0,0,24,6" />
                    <CheckBox Content="Begradigen" IsChecked="{Binding Deskew}" VerticalAlignment="Center" Margin="0,0,24,6"
                              ToolTip="Leicht schief gescannte Seiten (bis ±5°) gerade drehen" />
                    <CheckBox Content="Flecken entfernen" IsChecked="{Binding Despeckle}" VerticalAlignment="Center" Margin="0,0,24,6"
                              ToolTip="Kleine einzelne Staubpunkte (unter ca. 0,3 mm) entfernen; Notenpunkte bleiben erhalten" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                        <TextBlock Text="Kontrast (%)" Style="{StaticResource SettingLabel}" />
                        <Slider Width="140" Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
                        <TextBlock Text="{Binding Contrast}" Style="{StaticResource SettingValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                        <TextBlock Text="Helligkeit (%)" Style="{StaticResource SettingLabel}" />
                        <Slider Width="140" Minimum="-100" Maximum="100" Value="{Binding Brightness}" />
                        <TextBlock Text="{Binding Brightness}" Style="{StaticResource SettingValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                        <TextBlock Text="JPEG-Qualität" Style="{StaticResource SettingLabel}" />
                        <Slider Width="110" Minimum="1" Maximum="100" Value="{Binding JpegQuality}" />
                        <TextBlock Text="{Binding JpegQuality}" Style="{StaticResource SettingValue}" />
                    </StackPanel>
                    <CheckBox Content="PDF erstellen" IsChecked="{Binding CreatePdf}" VerticalAlignment="Center" Margin="0,0,24,6"
                              ToolTip="Nach der Bearbeitung alle Seiten zu &lt;Quellordner&gt;.pdf im Zielordner zusammenfassen" />
                    <Button Content="Standardwerte" Command="{Binding ResetSettingsCommand}" Margin="0,0,0,6" />
                </WrapPanel>
                <Expander Header="Erweitert">
                    <WrapPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="Hintergrund weiß ab Helligkeit" Style="{StaticResource SettingLabel}" />
                            <Slider Width="140" Minimum="1" Maximum="255" Value="{Binding WhitePoint}" />
                            <TextBlock Text="{Binding WhitePoint}" Style="{StaticResource SettingValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="Inhalt-Erkennung: dunkler als" Style="{StaticResource SettingLabel}" />
                            <Slider Width="140" Minimum="1" Maximum="254" Value="{Binding InkThreshold}" />
                            <TextBlock Text="{Binding InkThreshold}" Style="{StaticResource SettingValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="Rand um Inhalt (Pixel)" Style="{StaticResource SettingLabel}" />
                            <Slider Width="140" Minimum="0" Maximum="300" Value="{Binding Margin}" />
                            <TextBlock Text="{Binding Margin}" Style="{StaticResource SettingValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="Bildrand ignorieren (%)" Style="{StaticResource SettingLabel}" />
                            <Slider Width="140" Minimum="0" Maximum="20" TickFrequency="0.5" Value="{Binding IgnoreBorderPercent}" />
                            <TextBlock Text="{Binding IgnoreBorderPercent}" Style="{StaticResource SettingValue}" />
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- File list and preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Dateien" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="Name"
                     ItemContainerStyle="{StaticResource CompactListItem}" />

            <TextBlock Grid.Column="1" Text="Original" FontWeight="SemiBold" Margin="10,0,0,4" />
            <local:ZoomableImage Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="4" BorderThickness="1" CornerRadius="4"
                                 Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 Source="{Binding OriginalPreview}" ZoomKey="{Binding SelectedFile}" />

            <DockPanel Grid.Column="2" Margin="10,0,0,4">
                <TextBlock Text="Ergebnis" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PreviewStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <local:ZoomableImage Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" Padding="4" BorderThickness="1" CornerRadius="4"
                                 Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 Source="{Binding ResultPreview}" ZoomKey="{Binding SelectedFile}" />
        </Grid>

        <!-- Progress and actions -->
        <Grid Grid.Row="3" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ProgressBar Height="16" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}" />
                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Start" FontWeight="SemiBold" Command="{Binding StartCommand}" Margin="12,0,0,0" MinWidth="100" />
            <Button Grid.Column="2" Content="Abbrechen" Command="{Binding CancelCommand}" Margin="6,0,0,0" MinWidth="100" />
        </Grid>

        <!-- Log (plain ListBox with a two-column template: the .NET 9 Fluent theme does not render GridView) -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,0,4" TextElement.FontWeight="SemiBold">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Datei" />
                <TextBlock Grid.Column="1" Text="Ergebnis" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Log}" ItemContainerStyle="{StaticResource CompactListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
