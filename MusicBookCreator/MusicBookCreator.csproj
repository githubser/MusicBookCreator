<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 TFM: brings the CsWinRT projection for the built-in Windows OCR. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Music Book Creator</AssemblyName>
    <RootNamespace>MusicBookCreator</RootNamespace>
    <Product>Music Book Creator</Product>
    <Version>1.0.7</Version>
    <!-- Generated by ..\MusicBookCreator.IconGenerator -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The .NET 9 Fluent theme (App.xaml ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Self-contained single-file exe that runs on PCs without .NET: dotnet publish -c Release -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Image processing shared with the Paint.NET plugin (no copies, linked sources). -->
  <ItemGroup>
    <Compile Include="..\PdnScanCrop\ScanProcessor.cs" Link="Shared\ScanProcessor.cs" />
    <Compile Include="..\PdnScanCrop\ScanJpegWriter.cs" Link="Shared\ScanJpegWriter.cs" />
    <Compile Include="..\PdnScanCrop.Ocr\OcrScorer.cs" Link="Shared\OcrScorer.cs" />
  </ItemGroup>

</Project>
