<Project Sdk="Microsoft.NET.Sdk">

  <!-- OCR helper for PdnScanCrop. Runs out of process on .NET Framework 4.8, which has built-in
       WinRT interop, because Paint.NET only ships a trimmed WinRT projection without Windows.Media.Ocr. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinRT reference metadata for .NET Framework apps; nothing from it needs to be deployed. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

</Project>
