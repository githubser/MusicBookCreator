<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PdnDir>C:\Program Files\paint.net</PdnDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(PdnDir)\PaintDotNet.Base.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.ComponentModel.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Core.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Data.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Fundamentals.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Primitives.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.PropertySystem.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Windows.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Windows.Core.dll" Private="false" />
    <Reference Include="$(PdnDir)\PaintDotNet.Windows.Framework.dll" Private="false" />
  </ItemGroup>

  <!-- OCR helper for Auto rotation (separate .NET Framework 4.8 exe, see OcrOrientationDetector).
       Only built here for ordering; its exe is copied next to the plugin DLL. -->
  <ItemGroup>
    <ProjectReference Include="..\PdnScanCrop.Ocr\PdnScanCrop.Ocr.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <PropertyGroup>
    <OcrHelperExe>$(MSBuildThisFileDirectory)..\PdnScanCrop.Ocr\bin\$(Configuration)\net48\PdnScanCrop.Ocr.exe</OcrHelperExe>
  </PropertyGroup>

  <Target Name="CopyOcrHelper" AfterTargets="Build">
    <Copy SourceFiles="$(OcrHelperExe)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy plugin into Paint.NET's FileTypes folder after each build.
       Requires write access to $(PdnDir)\FileTypes and Paint.NET to be closed (DLL lock).
       Failures only produce a warning so the build itself still succeeds. -->
  <Target Name="DeployToPaintDotNet" AfterTargets="CopyOcrHelper">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(OcrHelperExe)"
          DestinationFolder="$(PdnDir)\FileTypes"
          SkipUnchangedFiles="true"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
